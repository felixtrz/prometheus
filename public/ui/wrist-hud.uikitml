<!--
  Wrist band (left grip, inside of the forearm). Bound by src/game/systems/wrist-system.ts.
  Display, plus one control: the Comfort button (bottom) opens a small row of chips
  (walk speed, turning, tunnel; settings.ts cycleSetting, the same as the journal board
  and the start panel). Tap a chip to step it; the row closes itself after a while.
  Health and food bars sit in their own dark well and shift green -> amber -> red; while a
  stew's well-fed buff lasts, a warm "Well fed" line with its time left sits under them.
  Natural size 40 x ~40 units; the system scales it to ~12 cm wide.
  Classes are prefixed "wr-" (UIKit classes share one global stylesheet).
-->
<style>
  .wr-root {
    display: flex;
    flex-direction: column;
    width: 40;
    padding-top: 2.6;
    padding-bottom: 2.8;
    padding-left: 3;
    padding-right: 3;
    gap: 1.5;
    font-family: inter;
    font-weight: 500;
    font-size: 2.6;
    line-height: 1.3;
    color: #ede9da;
    background-color: #192520;
    border-color: #75634a;
    border-width: 0.3;
    border-radius: 2.4;
  }
  .wr-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1.6;
    width: 100%;
  }
  .wr-spread { justify-content: space-between; }
  .wr-sky {
    width: 3.6;
    height: 3.6;
    color: #d4b180;
    flex-shrink: 0;
  }
  .wr-day {
    font-size: 3;
    font-weight: 700;
    flex-shrink: 0;
    min-width: 11;
  }
  .wr-fire-icon {
    width: 2.8;
    height: 2.8;
    color: #a5b2a5;
    flex-shrink: 0;
  }
  .wr-fire {
    font-size: 2.5;
    font-weight: 700;
    color: #a5b2a5;
    flex-shrink: 0;
  }
  .wr-hint {
    font-size: 2.05;
    line-height: 1.35;
    color: #c3cdbf;
  }
  .wr-tonight-row {
    display: none;
    flex-direction: row;
    align-items: center;
    gap: 1.2;
  }
  .wr-tonight-icon {
    flex-shrink: 0;
    width: 2.6;
    height: 2.6;
    color: #d4b180;
  }
  .wr-tonight {
    font-size: 2.1;
    font-weight: 700;
    color: #d4b180;
  }
  .wr-icon {
    flex-shrink: 0;
    width: 3;
    height: 3;
  }
  .wr-icon-hunger { color: #d4b180; }
  .wr-vitals {
    display: flex;
    flex-direction: column;
    gap: 1.3;
    width: 100%;
    padding-top: 1.2;
    padding-bottom: 1.3;
    padding-left: 1.4;
    padding-right: 1.4;
    border-radius: 1.2;
    background-color: #111a16;
  }
  .wr-vital-icon {
    flex-shrink: 0;
    width: 3.4;
    height: 3.4;
    color: #86b36a;
  }
  .wr-track {
    display: flex;
    flex-direction: row;
    flex-grow: 1;
    height: 2.6;
    border-radius: 1.3;
    background-color: #2a3830;
  }
  .wr-fill-hunger {
    height: 100%;
    width: 70%;
    border-radius: 1.3;
    background-color: #86b36a;
  }
  .wr-fill-health {
    height: 100%;
    width: 100%;
    border-radius: 1.3;
    background-color: #86b36a;
  }
  .wr-val {
    flex-shrink: 0;
    width: 5;
    font-size: 3;
    font-weight: 700;
    text-align: right;
    color: #ede9da;
  }
  .wr-rule {
    width: 100%;
    height: 0.2;
    background-color: #3a4a40;
    margin-top: 0.4;
    margin-bottom: 0.2;
  }
  .wr-eyebrow {
    font-size: 1.9;
    font-weight: 700;
    color: #cba875;
  }
  .wr-obj {
    font-size: 2.9;
    font-weight: 700;
    line-height: 1.25;
    color: #ede9da;
  }
  .wr-fed {
    display: none;
    flex-direction: row;
    align-items: center;
    gap: 1.2;
    padding-top: 0.3;
  }
  .wr-fed-icon {
    flex-shrink: 0;
    width: 3.4;
    height: 3.4;
    color: #e9b36a;
  }
  .wr-fed-label {
    flex-grow: 1;
    font-size: 2.4;
    font-weight: 700;
    color: #e9c58f;
  }
  .wr-fed-val {
    flex-shrink: 0;
    font-size: 2.5;
    font-weight: 700;
    color: #e9b36a;
  }
  .wr-bolts {
    display: none;
    flex-direction: row;
    align-items: center;
    gap: 1.6;
    padding-top: 1;
    padding-bottom: 1;
    padding-left: 1.6;
    padding-right: 1.6;
    border-radius: 1;
    background-color: #25352d;
  }
  .wr-bolt-label {
    flex-grow: 1;
    font-size: 2.4;
    color: #d3dacd;
  }
  .wr-bolt-val {
    font-size: 3;
    font-weight: 700;
    color: #d4b180;
  }
  .wr-comfort-btn {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 0.9;
    width: 100%;
    height: 4.6;
    margin-top: 0.3;
    border-radius: 1;
    border-width: 0.2;
    border-color: #4c5c50;
    background-color: #1e2b24;
    cursor: pointer;
  }
  .wr-comfort-btn:hover { background-color: #2c3d33; }
  .wr-comfort-icon {
    flex-shrink: 0;
    width: 2.4;
    height: 2.4;
    color: #a5b2a5;
  }
  .wr-comfort-label {
    font-size: 2.1;
    font-weight: 700;
    color: #c3cdbf;
  }
  .wr-comfort-row {
    display: none;
    flex-direction: row;
    gap: 0.8;
    width: 100%;
  }
  .wr-chip {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 30%;
    flex-grow: 1;
    padding-top: 0.6;
    padding-bottom: 0.7;
    padding-left: 0.9;
    padding-right: 0.5;
    border-radius: 0.9;
    border-width: 0.2;
    border-color: #667567;
    background-color: #111a16;
    cursor: pointer;
  }
  .wr-chip:hover { background-color: #2c3d33; }
  .wr-chip-label {
    font-size: 1.7;
    font-weight: 700;
    color: #a5b2a5;
  }
  .wr-chip-val {
    font-size: 2.3;
    font-weight: 700;
    color: #e9c58f;
  }
</style>
<div class="wr-root">
  <div class="wr-row wr-spread">
    <div class="wr-row" style="width: auto; flex-shrink: 0">
      <Sun id="wr-ic-day" class="wr-sky"></Sun>
      <Sunset id="wr-ic-dusk" class="wr-sky" style="display: none"></Sunset>
      <Moon id="wr-ic-night" class="wr-sky" style="display: none"></Moon>
      <Sunrise id="wr-ic-dawn" class="wr-sky" style="display: none"></Sunrise>
      <span id="wr-day" class="wr-day">Day 1</span>
    </div>
    <div class="wr-row" style="width: auto; gap: 0.9; flex-shrink: 0">
      <Flame id="wr-ic-fire" class="wr-fire-icon"></Flame>
      <span id="wr-fire" class="wr-fire">Fire out</span>
    </div>
  </div>
  <div class="wr-vitals">
    <div class="wr-row">
      <Heart id="wr-ic-health" class="wr-vital-icon"></Heart>
      <div class="wr-track"><div id="wr-health-fill" class="wr-fill-health"></div></div>
      <span id="wr-health-val" class="wr-val">100</span>
    </div>
    <div class="wr-row">
      <Drumstick id="wr-ic-hunger" class="wr-vital-icon"></Drumstick>
      <div class="wr-track"><div id="wr-hunger-fill" class="wr-fill-hunger"></div></div>
      <span id="wr-hunger-val" class="wr-val">70</span>
    </div>
    <div id="wr-fed-row" class="wr-fed">
      <Soup class="wr-fed-icon"></Soup>
      <span class="wr-fed-label">Well fed</span>
      <span id="wr-fed" class="wr-fed-val">1:30</span>
    </div>
  </div>
  <div class="wr-rule"></div>
  <span id="wr-obj-label" class="wr-eyebrow">NOW</span>
  <span id="wr-obj" class="wr-obj">Get out of the wreck</span>
  <span id="wr-hint" class="wr-hint">Axe above the door; strike the door till it gives.</span>
  <div id="wr-tonight-row" class="wr-tonight-row">
    <Moon class="wr-tonight-icon"></Moon>
    <span class="wr-tonight">Tonight: Survive the night, then sleep</span>
  </div>
  <div id="wr-bolts-row" class="wr-bolts">
    <Crosshair class="wr-icon wr-icon-hunger"></Crosshair>
    <span class="wr-bolt-label">Bolts loaded</span>
    <span id="wr-bolts" class="wr-bolt-val">0</span>
  </div>
  <div id="wr-comfort-row" class="wr-comfort-row">
    <button id="wr-set-speed" class="wr-chip"><span class="wr-chip-label">SPEED</span><span id="wr-set-speed-val" class="wr-chip-val">Normal</span></button>
    <button id="wr-set-turn" class="wr-chip"><span class="wr-chip-label">TURN</span><span id="wr-set-turn-val" class="wr-chip-val">45°</span></button>
    <button id="wr-set-tunnel" class="wr-chip"><span class="wr-chip-label">TUNNEL</span><span id="wr-set-tunnel-val" class="wr-chip-val">On</span></button>
  </div>
  <button id="wr-comfort-btn" class="wr-comfort-btn">
    <SlidersHorizontal class="wr-comfort-icon"></SlidersHorizontal>
    <span id="wr-comfort-label" class="wr-comfort-label">Comfort</span>
  </button>
</div>
