  const sh = new THREE.Shape(); for (const [x, y] of [[-2.2, 0], [-1.6, 3.5], [-1.9, 5.5], [-1.0, 8.5], [-.4, 11.2], [.4, 11.6], [1.1, 9.0], [1.9, 6.0], [1.5, 3.2], [2.3, 0]] as number[][]) sh.lineTo(x, y); sh.closePath();
