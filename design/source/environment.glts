// ---------- Horizon: smooth, sun-shaded mountain masses (lit face / shade face like the concept), a dark tree-line, and the rock-spire landmark.
function mountain(x: number, z: number, w: number, h: number, d: number, m: THREE.Material, rot = 0) {
  const g = geo(new THREE.ConeGeometry(1, 1, 30, 9)); const p = g.attributes.position as THREE.BufferAttribute;
  for (let i = 0; i < p.count; i++) { const px = p.getX(i), py = p.getY(i) + .5, pz = p.getZ(i); const a = Math.atan2(pz, px); const wob = 1 + .10 * Math.sin(a * 3 + x) + .06 * Math.sin(a * 7 + z) + .035 * Math.sin(a * 13 + py * 9 + x); const flare = (1 + (1 - py) * .30) * (1 + .9 * py * (1 - py)); p.setXYZ(i, px * wob * flare, py - .5 + .012 * Math.sin(a * 11 + py * 17), pz * wob * flare); }
  g.computeVertexNormals();
  const mesh = new THREE.Mesh(g, m); mesh.scale.set(w, h, d); mesh.position.set(x, h * .5 - .3, z); mesh.rotation.y = rot; root.add(mesh); return mesh;
}
