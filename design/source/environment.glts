for (let i = 0; i < 20; i++) { const a = i * 1.37; const r = 1.25 + (i % 7) * .43; const x = Math.cos(a) * r; const z = .15 + Math.sin(a) * r * .68; const l = new THREE.Mesh(litterGeo, litterA); l.rotation.x = -Math.PI / 2; l.rotation.z = a * .55; l.scale.set(1.0 + (i % 3) * .35, .35, 1); l.position.set(x, .016, z); root.add(l); }
