}

// ---------- Vegetation: broad curved blades in clumps (like the concept), two-sided with upward normals so no blade goes black.
const bladeGeo = (() => {
  const g = new THREE.PlaneGeometry(.11, .5, 1, 4); const p = g.attributes.position as THREE.BufferAttribute;
  for (let i = 0; i < p.count; i++) { const y = p.getY(i) + .25; const t = y / .5; p.setX(i, p.getX(i) * (1 - t * .85)); p.setZ(i, t * t * .18); p.setY(i, y); }
