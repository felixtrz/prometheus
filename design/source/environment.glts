for (let i = 0; i < 16; i++) { const a = i * .91; const r = 1.55 + (i % 5) * .5; const x = Math.cos(a) * r; const z = .25 + Math.sin(a) * r * .7; if (Math.abs(x) < .85 && z < .8) continue; const p = new THREE.Mesh(pebbleGeo, i % 2 ? pebbleA : pebbleB); p.scale.set(1 + (i % 2) * .35, .42, .75 + (i % 4) * .12); p.position.set(x, terrainY(x, z) + .03, z); p.rotation.y = a * .7; root.add(p); }
// pebbles along the path edges
