const lanternMetal = std(0x4a4038, { roughness: .7, metalness: .15 }); const lanternGlass = mat(new THREE.MeshBasicMaterial({ color: 0xffc46a, transparent: true, opacity: .75 })); const lanternFlame = mat(new THREE.MeshBasicMaterial({ color: 0xfff1b0 }));
const cupMat = std(0x8a5f3a); const pebbleA = std(0x8f959a), pebbleB = std(0x6f767c); const litterA = std(0x8a6a45);
const ridgeNear = std(0x5b8168), ridgeMid = std(0x6c8fa3), ridgeFar = std(0x86a6c6), treelineMat = std(0x3f6b3c, { side: THREE.DoubleSide });
const spireMat = std(0x8e949a), spireDark = std(0x6f767e); const cloudMat = std(0xf2f5f8, { emissive: new THREE.Color(0xc8d4e0), emissiveIntensity: .9, envMapIntensity: .2 }), cloudShade = cloudMat;

function cylinderBetween(a: THREE.Vector3, b: THREE.Vector3, r: number, m: THREE.Material, seg = 12, parent: THREE.Object3D = root) {
  const q = new THREE.Mesh(geo(new THREE.CylinderGeometry(r, r, a.distanceTo(b), seg)), m);
  q.position.copy(a).add(b).multiplyScalar(.5); q.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), b.clone().sub(a).normalize()); parent.add(q); return q;
}

// ---------- Baked contact shadows: recorded here, then multiplied into the ground vertex colours (no transparency, no realtime shadows).
type Shade = { x: number; z: number; rx: number; rz: number; op: number; rot: number };
const shades: Shade[] = [];
const sunDir = new THREE.Vector3(7, -22, -11).normalize(); // key light direction (see rig below)
const sunSlope = Math.hypot(sunDir.x, sunDir.z) / -sunDir.y; const sunAng = Math.atan2(sunDir.x, sunDir.z);
function shadow(x: number, z: number, rx: number, rz: number, op: number, height = 0, rotY = 0) {
  const off = height * sunSlope; shades.push({ x: x + Math.sin(sunAng) * off, z: z + Math.cos(sunAng) * off, rx, rz, op, rot: rotY });
}
function shadeAt(x: number, z: number) {
  let k = 1;
  for (const s of shades) {
    const dx = x - s.x, dz = z - s.z; if (Math.abs(dx) > s.rx * 1.2 && Math.abs(dz) > s.rz * 1.2 && Math.abs(dx) + Math.abs(dz) > (s.rx + s.rz) * 1.2) continue;
    const c = Math.cos(-s.rot), sn = Math.sin(-s.rot); const lx = (dx * c - dz * sn) / s.rx, lz = (dx * sn + dz * c) / s.rz;
    const d = Math.hypot(lx, lz); if (d >= 1) continue;
    const f = 1 - d * d; k *= 1 - s.op * f * f;
  }
  return k;
}
function treeShadow(x: number, z: number, h: number, canopyR: number, canopyY: number) {
  shadow(x, z, canopyR * 1.45, canopyR * 1.45, .5, canopyY, 0);      // canopy shadow displaced along the sun
  shadow(x, z, h * .06 + canopyR * .4, h * .06 + canopyR * .4, .45, 0); // trunk contact
}

// ---------- Ground: one vertex-painted mesh with a hand-painted mottle; dirt blends into grass through noisy falloff.
function paintedMottle(size = 256) {
  const grid = 32; const cells: number[] = []; let seed = 7;
  const rnd = () => { seed = (seed * 16807) % 2147483647; return seed / 2147483647; };
  for (let i = 0; i < grid * grid; i++) cells.push(rnd());
  const cell = (x: number, y: number) => cells[((y % grid + grid) % grid) * grid + ((x % grid + grid) % grid)];
  const value = (u: number, v: number) => { const x = Math.floor(u), y = Math.floor(v); const fx = u - x, fy = v - y; const sx = fx * fx * (3 - 2 * fx), sy = fy * fy * (3 - 2 * fy); return (cell(x, y) * (1 - sx) + cell(x + 1, y) * sx) * (1 - sy) + (cell(x, y + 1) * (1 - sx) + cell(x + 1, y + 1) * sx) * sy; };
  const data = new Uint8Array(size * size * 4);
  for (let y = 0; y < size; y++) for (let x = 0; x < size; x++) {
    const u = x / size * grid, v = y / size * grid;
    // fine speckle and short strokes dominate; the large octave is kept faint so the ground doesn't read as cloudy camouflage
    let n = (value(u * .5, v * .5) - .5) * .22 + (value(u * 1.6 + 5, v * 1.6 + 2) - .5) * .38 + (value(u * 4.2 + 11, v * 4.2 + 7) - .5) * .40;
    n += .16 * Math.sin(v * 16 + value(Math.floor(u * 4), 3) * 12) * (value(u * 5 + 20, v * 1.1 + 3) - .4);
    n += (value(u * 9 + 31, v * 9 + 17) > .86 ? -.22 : 0); // sparse dark speckles
    const m = Math.max(0, Math.min(255, Math.round((1 + n * .9) * 170)));
    const i = (y * size + x) * 4; data[i] = data[i + 1] = data[i + 2] = m; data[i + 3] = 255;
  }
  const t = new THREE.DataTexture(data, size, size, THREE.RGBAFormat); t.needsUpdate = true; t.wrapS = t.wrapT = THREE.RepeatWrapping; t.repeat.set(18, 18); t.anisotropy = 4; t.magFilter = THREE.LinearFilter; t.minFilter = THREE.LinearMipmapLinearFilter; t.generateMipmaps = true; tx.push(t); return t;
}
const mottle = paintedMottle();
const groundMat = mat(new THREE.MeshStandardMaterial({ vertexColors: true, roughness: 1, flatShading: true }));
const noise = (x: number, z: number) => .5 * Math.sin(x * 1.7 + z * .9) + .3 * Math.sin(x * .6 - z * 2.3 + 1.3) + .2 * Math.sin((x + z) * 3.1 + .7);
const smooth = (a: number, b: number, v: number) => { const t = Math.min(1, Math.max(0, (v - a) / (b - a))); return t * t * (3 - 2 * t); };
const bumps = [[-7, -7, 4.5, .55], [7, -8, 5, .7], [-3, -13, 7, 1.1], [6, -14, 7.5, 1.2], [0, -22, 14, 1.3], [-12, -3, 4, .5], [12, -2, 4, .5]] as number[][];
function terrainY(x: number, z: number) { let y = 0; for (const [bx, bz, bw, bh] of bumps) y += bh * Math.exp(-(((x - bx) / bw) ** 2 + ((z - bz) / bw) ** 2) * 1.6); return y + .04 * noise(x * .55, z * .55) - .035; }
const pathPts = new THREE.QuadraticBezierCurve3(new THREE.Vector3(.1, 0, -1.6), new THREE.Vector3(-.9, 0, -5.5), new THREE.Vector3(.6, 0, -11)).getPoints(40);
function dirtMask(x: number, z: number) {
  const n = noise(x, z), n3 = noise(x * 4.5 + 9, z * 4.5 - 4);
  const e = Math.sqrt((x / 4.0) ** 2 + ((z - .1) / 3.1) ** 2) + n * .12 + n3 * .07;
  let d = smooth(1.08, .80, e);
