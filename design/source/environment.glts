function deciduous(x: number, z: number, h: number, rot: number, variant: number) {
  const g = new THREE.Group(); const trunkH = h * .5;
  const trunk = new THREE.Mesh(geo(new THREE.CylinderGeometry(h * .045, h * .07, trunkH, 7)), trunkMat); trunk.position.y = trunkH / 2; g.add(trunk);
  for (let i = 0; i < 3; i++) { const a = rot + i * 2.1; cylinderBetween(new THREE.Vector3(0, trunkH * (.55 + i * .15), 0), new THREE.Vector3(Math.cos(a) * h * .22, trunkH + h * .12, Math.sin(a) * h * .22), h * .022, trunkDark, 5, g); }
