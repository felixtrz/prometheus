// ---------- Materials: one shading model everywhere (MeshStandard, roughness 1, smooth normals, IBL ambient).
const canopy = [std(0x8cbf3f), std(0x74a835), std(0xa3cc4d)];
const trunkMat = std(0x8a5f3a), trunkDark = std(0x6b4830);
