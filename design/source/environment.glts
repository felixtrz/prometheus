const groundGeo = geo(new THREE.PlaneGeometry(46, 46, 112, 112).toNonIndexed()); groundGeo.rotateX(-Math.PI / 2);
function buildGround() {
  const pos = groundGeo.attributes.position as THREE.BufferAttribute; const colors = new Float32Array(pos.count * 3);
  const cGrassA = new THREE.Color(0x7fb038), cGrassB = new THREE.Color(0x9dcb46), cGrassC = new THREE.Color(0x5f9430), cDirtA = new THREE.Color(0xb98d57), cDirtB = new THREE.Color(0x9a6f42); const c = new THREE.Color();
  const jit = (x: number, z: number) => { const a = Math.sin(x * 12.9898 + z * 78.233) * 43758.5453; return a - Math.floor(a); };
  // jitter shared grid vertices consistently (same input -> same offset) so triangles stay watertight
