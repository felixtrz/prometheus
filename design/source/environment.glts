}
// Low-poly cumulus: clusters of flat-shaded icosahedra, near-unlit so the underside stays a light grey.
const cloudGeo = geo(new THREE.IcosahedronGeometry(1, 2));
function cloud(x: number, y: number, z: number, s: number) {
  const g = new THREE.Group(); const parts = [[-.9, .0, .55, .40], [-.45, .18, .70, .56], [.1, .28, .82, .66], [.65, .14, .62, .48], [1.1, -.02, .44, .34], [-.2, -.06, 1.05, .30], [.55, -.06, .95, .30]];
  parts.forEach(([px, py, sx, sy], i) => { const c = new THREE.Mesh(cloudGeo, cloudMat); c.position.set(px * s, py * s, 0); c.scale.set(sx * s, sy * s, .55 * s); c.rotation.set(i * .9, i * .5, i * 1.1); g.add(c); });
  g.position.set(x, y, z); root.add(g);
}
