// ---------- Market models (Quaternius nature kit). Foliage gets bent normals (outward + up from the trunk axis) and is duplicated
// with reversed winding so both faces shade like a soft canopy volume instead of flat planes going black on their back side.
const draco = new DRACOLoader(loadingManager); draco.setDecoderPath("https://cdn.jsdelivr.net/npm/three@0.185.0/examples/jsm/libs/draco/gltf/");
const gltf = new GLTFLoader(loadingManager); gltf.setDRACOLoader(draco);
const gltfOwned: THREE.Material[] = [];
function bendNormals(g: THREE.BufferGeometry, center: THREE.Vector3, minY: number, height: number) {
