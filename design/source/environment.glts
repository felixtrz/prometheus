  for (let i = 0; i < count; i++) { const blade = new THREE.Mesh(bladeGeo, m); const a = i / count * Math.PI * 2 + x; blade.rotation.y = a; blade.rotation.x = -.55 - (i % 2) * .2; blade.position.set(Math.sin(a) * .03 * s, 0, Math.cos(a) * .03 * s); blade.scale.set(s * (1 + (i % 3) * .15), s * (.85 + (i % 2) * .3), s); g.add(blade); }
  if (flower) for (let k = 0; k < 3; k++) { const st = new THREE.Mesh(geo(new THREE.CylinderGeometry(.006, .008, .3 * s, 5)), leafDark); st.position.set(Math.cos(k * 2.1) * .07 * s, .15 * s, Math.sin(k * 2.1) * .07 * s); g.add(st); const f = new THREE.Mesh(geo(new THREE.SphereGeometry(.04 * s, 8, 6)), flower); f.scale.y = .55; f.position.set(Math.cos(k * 2.1) * .07 * s, .31 * s, Math.sin(k * 2.1) * .07 * s); g.add(f); }
