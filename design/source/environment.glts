{
  const g = new THREE.Group();
  const base = new THREE.Mesh(geo(new THREE.BoxGeometry(1.7, .11, 1.0)), matBase); base.position.y = .055; g.add(base);
  const top = new THREE.Mesh(geo(new THREE.BoxGeometry(1.56, .06, .88)), matTop); top.position.y = .13; g.add(top);
  const roll = new THREE.Mesh(geo(new THREE.CylinderGeometry(.24, .24, 1.25, 9)), rollMat); roll.rotation.z = Math.PI / 2; roll.position.set(-.04, .40, -.12); g.add(roll);
  for (const dx of [-.42, .38]) { const st = new THREE.Mesh(geo(new THREE.CylinderGeometry(.25, .25, .09, 9)), rollStripe); st.rotation.z = Math.PI / 2; st.position.set(dx, .40, -.12); g.add(st); }
  for (const side of [-1, 1]) { const end = new THREE.Mesh(geo(new THREE.CylinderGeometry(.20, .20, .02, 9)), rollCore); end.rotation.z = Math.PI / 2; end.position.set(side * .635, .40, -.12); g.add(end); for (const r of [.06, .12]) { const sp = new THREE.Mesh(geo(new THREE.TorusGeometry(r, .012, 4, 9)), rollStripe); sp.rotation.y = Math.PI / 2; sp.position.set(side * .648, .40, -.12); g.add(sp); } }
  for (const dx of [-.42, .38]) { const tie = new THREE.Mesh(geo(new THREE.TorusGeometry(.25, .014, 4, 9)), ropeMat); tie.rotation.y = Math.PI / 2; tie.position.set(dx, .40, -.12); g.add(tie); }
  g.position.set(-2.4, 0, -.35); g.rotation.y = -.95; g.scale.setScalar(.8); root.add(g);
