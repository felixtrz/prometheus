// Bright painterly sky.
const skyMat = mat(new THREE.ShaderMaterial({ side: THREE.BackSide, depthWrite: false, uniforms: { top: { value: new THREE.Color(0x2e6fd3) }, mid: { value: new THREE.Color(0x6fb0ee) }, bottom: { value: new THREE.Color(0xc7e6f9) } }, vertexShader: `varying float vY; void main(){vec4 wp=modelMatrix*vec4(position,1.0); vY=normalize(wp.xyz).y; gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.0);}`, fragmentShader: `uniform vec3 top; uniform vec3 mid; uniform vec3 bottom; varying float vY; void main(){vec3 c=mix(bottom,mid,smoothstep(0.0,0.22,vY)); c=mix(c,top,smoothstep(0.22,0.75,vY)); gl_FragColor=vec4(c,1.0);}` }));
root.add(new THREE.Mesh(geo(new THREE.SphereGeometry(80, 24, 12)), skyMat));

// Quest target: no realtime shadows. Ambient from a procedural sky→horizon→grass gradient environment (matches the painterly sky,
// no dark forest canopy bleeding into the trees); one sun; contact shadows baked into the ground above.
function gradientEnv(w = 64, h = 32) {
  const top = new THREE.Color(0x4f86d6), horizon = new THREE.Color(0xdbe9f3), ground = new THREE.Color(0x9bb060), groundDeep = new THREE.Color(0x6f8442);
  const d = new Uint8Array(w * h * 4); const c = new THREE.Color();
  for (let y = 0; y < h; y++) { const v = 1 - (y + .5) / h; // 1 = zenith, 0 = nadir
    if (v > .5) c.copy(horizon).lerp(top, Math.pow((v - .5) / .5, .7)); else c.copy(ground).lerp(groundDeep, Math.pow((.5 - v) / .5, .8)).lerp(horizon, Math.max(0, 1 - (.5 - v) / .08) * .6);
    for (let x = 0; x < w; x++) { const i = (y * w + x) * 4; d[i] = Math.round(c.r * 255); d[i + 1] = Math.round(c.g * 255); d[i + 2] = Math.round(c.b * 255); d[i + 3] = 255; } }
  const t = new THREE.DataTexture(d, w, h, THREE.RGBAFormat); t.colorSpace = THREE.SRGBColorSpace; t.mapping = THREE.EquirectangularReflectionMapping; t.magFilter = THREE.LinearFilter; t.minFilter = THREE.LinearFilter; t.needsUpdate = true; tx.push(t); return t;
}
scene.environment = gradientEnv(); scene.environmentIntensity = .55;
// Atmospheric perspective: linear fog toward the sky-horizon tint. The sky sphere ignores fog (ShaderMaterial), so only the world recedes.
scene.fog = new THREE.Fog(0xc3dcef, 14, 120);
const hemi = new THREE.HemisphereLight(0xb9d6ff, 0x73824a, .15);
const key = new THREE.DirectionalLight(0xfff1d4, 1.7); key.position.set(-7, 22, 9); key.target.position.set(0, 0, -2);
// cool back-fill lifts silhouettes off the tree line without adding a second visible light direction
const rim = new THREE.DirectionalLight(0x9fc3ff, .35); rim.position.set(6, 9, -12); rim.target.position.set(0, 1, 0);
root.add(hemi, key, key.target, rim, rim.target);

scene.defaultCamera = new THREE.PerspectiveCamera(58, 1, .1, 300); scene.defaultCamera.position.set(0, 1.55, 4.3); scene.defaultCamera.lookAt(0, .85, -1.2);
if (isPreview) { scene.rendering.toneMapping = THREE.ACESFilmicToneMapping; scene.rendering.toneMappingExposure = 1.0; }

