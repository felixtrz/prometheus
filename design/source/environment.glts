  const spire = new THREE.Mesh(geo(new THREE.ExtrudeGeometry(sh, { depth: 2.4, bevelEnabled: true, bevelSize: .45, bevelThickness: .45, bevelSegments: 1 })), spireMat);
  spire.position.set(9.5, 2.0, -40); spire.rotation.y = .35; spire.scale.setScalar(.75); root.add(spire);
