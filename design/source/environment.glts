  else { const p = back.attributes.position as THREE.BufferAttribute; for (let i = 0; i < p.count; i += 3) { const x = p.getX(i + 1), y = p.getY(i + 1), z = p.getZ(i + 1); p.setXYZ(i + 1, p.getX(i + 2), p.getY(i + 2), p.getZ(i + 2)); p.setXYZ(i + 2, x, y, z); } }
  const merged = mergeGeometries([g, back], false); back.dispose(); return merged;
}
async function loadModel(path: string, tint: THREE.Color, foliage = false) {
  const g = await gltf.loadAsync(new URL(path, import.meta.url).href); const obj = g.scene;
  const box = new THREE.Box3().setFromObject(obj); const size = new THREE.Vector3(); box.getSize(size); const center = new THREE.Vector3(); box.getCenter(center);
  obj.traverse((o) => {
    const m = o as THREE.Mesh;
    if (m.isMesh) {
      m.castShadow = false; m.receiveShadow = false;
      if (foliage) { const local = center.clone(); m.worldToLocal(local); const lb = new THREE.Box3().setFromBufferAttribute(m.geometry.attributes.position as THREE.BufferAttribute); bendNormals(m.geometry, local, lb.min.y, lb.max.y - lb.min.y); m.geometry = geo(twoSided(m.geometry)); }
      else if (m.geometry && !m.geometry.attributes.normal) m.geometry.computeVertexNormals();
      const arr = Array.isArray(m.material) ? m.material : [m.material];
      for (const mm of arr) {
        const s = mm as THREE.MeshStandardMaterial;
        s.color.multiply(tint); s.roughness = 1; s.metalness = 0; s.flatShading = false;
        s.transparent = false; s.depthWrite = true; s.depthTest = true; s.side = foliage ? THREE.FrontSide : THREE.DoubleSide;
        s.alphaTest = (s.map && (s.map as THREE.Texture).format === THREE.RGBAFormat) || s.alphaMap ? .5 : 0;
        if (foliage) { s.envMapIntensity = .45; } else s.envMapIntensity = 1;
        s.needsUpdate = true; gltfOwned.push(s);
      }
    }
  });
