import * as THREE from "three";
import { RoundedBoxGeometry } from "three/addons/geometries/RoundedBoxGeometry.js";
import { isPreview, loadingManager, onDispose, scene } from "@drawcall/glts";

const root = new THREE.Group();
scene.add(root);

const gs: THREE.BufferGeometry[] = [];
const ms: THREE.Material[] = [];
const tx: THREE.Texture[] = [];
const geo = <T extends THREE.BufferGeometry>(g: T) => (gs.push(g), g);
const mat = <T extends THREE.Material>(m: T) => (ms.push(m), m);

const loader = new THREE.TextureLoader(loadingManager);
const woodMap = await loader.loadAsync(new URL("/9gnkuokpi414nb/public/wood-planks-08_baseColor.png", import.meta.url).href);
const woodRough = await loader.loadAsync(new URL("/9gnkuokpi414nb/public/wood-planks-08_roughness.png", import.meta.url).href);
const woodNormal = await loader.loadAsync(new URL("/9gnkuokpi414nb/public/wood-planks-08_normal.png", import.meta.url).href);
for (const t of [woodMap, woodRough, woodNormal]) {
  t.wrapS = t.wrapT = THREE.RepeatWrapping;
  t.repeat.set(1.5, 1.0);
  t.anisotropy = 2;
  tx.push(t);
}
woodMap.colorSpace = THREE.SRGBColorSpace;

const texturedWood = (r: number, g: number, b: number, roughness = 0.84) => mat(new THREE.MeshStandardMaterial({
  color: new THREE.Color().setRGB(r, g, b), map: woodMap, roughnessMap: woodRough, normalMap: woodNormal,
  normalScale: new THREE.Vector2(0.12, 0.12), roughness, metalness: 0,
}));

const woodA = texturedWood(1.95, 1.35, 0.80, 0.80);
const woodB = texturedWood(1.75, 1.15, 0.68, 0.86);
const woodDark = texturedWood(1.05, 0.70, 0.46, 0.92);
const woodEdge = texturedWood(2.10, 1.50, 0.92, 0.80);
const slotBase = mat(new THREE.MeshStandardMaterial({ color: 0x4a3c33, roughness: 0.98 }));
const slotRail = mat(new THREE.MeshStandardMaterial({ color: 0xb08853, roughness: 0.90 }));
const cloth = mat(new THREE.MeshStandardMaterial({ color: 0xd2c3a0, roughness: 1 }));
const clothDark = mat(new THREE.MeshStandardMaterial({ color: 0xa8936d, roughness: 1 }));
const resin = mat(new THREE.MeshStandardMaterial({ color: 0xb96929, roughness: 0.74 }));
const resinTop = mat(new THREE.MeshStandardMaterial({ color: 0xe0923a, roughness: 0.38 }));
const metal = mat(new THREE.MeshStandardMaterial({ color: 0x6d747a, roughness: 0.64, metalness: 0.10 }));
const metalDark = mat(new THREE.MeshStandardMaterial({ color: 0x484f54, roughness: 0.72, metalness: 0.08 }));
const iron = mat(new THREE.MeshStandardMaterial({ color: 0x363c40, roughness: 0.76, metalness: 0.12 }));
const shadow = mat(new THREE.MeshBasicMaterial({ color: 0x000000, transparent: true, opacity: 0.13, depthWrite: false }));
for (const m of ms) { const s = m as THREE.MeshStandardMaterial; if (s.isMeshStandardMaterial) { s.flatShading = true; s.normalMap = null; } }

function chamfer(size: [number, number, number], _radius: number, pos: [number, number, number], material: THREE.Material, parent = root) {
  const m = new THREE.Mesh(geo(new THREE.BoxGeometry(size[0], size[1], size[2])), material);
  m.position.set(...pos); parent.add(m); return m;
}
function box(size: [number, number, number], pos: [number, number, number], material: THREE.Material, parent = root) {
  const m = new THREE.Mesh(geo(new THREE.BoxGeometry(...size)), material);
  m.position.set(...pos); parent.add(m); return m;
}
function cyl(rt: number, rb: number, h: number, seg: number, pos: [number, number, number], material: THREE.Material, parent = root) {
  const m = new THREE.Mesh(geo(new THREE.CylinderGeometry(rt, rb, h, Math.min(seg, 8))), material);
  m.position.set(...pos); parent.add(m); return m;
}

// Worktop: three substantial planks, crisp overall with tiny edge breaks.
for (const [z, material, y, rz] of [
  [-0.31, woodB, 0.86, -0.004],
  [ 0.00, woodA, 0.868, 0.003],
  [ 0.31, woodB, 0.858, -0.002],
] as [number, THREE.Material, number, number][]) {
  const p = chamfer([2.48, 0.13, 0.285], 0.014, [0, y, z], material);
  p.rotation.z = rz;
}
// End battens and underside apron.
for (const x of [-1.20, 1.20]) chamfer([0.11, 0.16, 0.91], 0.012, [x, 0.80, 0], woodEdge);
for (const z of [-0.43, 0.43]) chamfer([2.28, 0.13, 0.095], 0.012, [0, 0.70, z], woodDark);

// Legs with square feet and visible pegged joinery.
for (const x of [-0.98, 0.98]) for (const z of [-0.34, 0.34]) {
  chamfer([0.17, 0.78, 0.17], 0.012, [x, 0.40, z], woodDark);
  chamfer([0.23, 0.07, 0.23], 0.012, [x, 0.035, z], woodB);
  const peg = cyl(0.018, 0.018, 0.012, 12, [x + (x < 0 ? -0.086 : 0.086), 0.73, z], woodEdge);
  peg.rotation.z = Math.PI / 2;
}
// Lower stretchers and shelf planks.
for (const z of [-0.35, 0.35]) chamfer([1.92, 0.09, 0.095], 0.010, [0, 0.29, z], woodDark);
for (const z of [-0.16, 0.16]) chamfer([1.86, 0.065, 0.28], 0.010, [0, 0.315, z], z < 0 ? woodA : woodB);
// Side cross braces.
for (const x of [-1.02, 1.02]) {
  const b1 = box([0.065, 0.065, 0.72], [x, 0.44, 0], woodEdge); b1.rotation.x = 0.78;
  const b2 = box([0.065, 0.065, 0.72], [x, 0.44, 0], woodEdge); b2.rotation.x = -0.78;
}

// Four explicit crafting bays built as real rails around a shallow base.
const slotCenters = [-0.83, -0.28, 0.28, 0.83];
for (const x of slotCenters) {
  chamfer([0.46, 0.026, 0.54], 0.008, [x, 0.974, 0], slotBase);
  chamfer([0.50, 0.038, 0.032], 0.008, [x, 1.003, -0.292], slotRail);
  chamfer([0.50, 0.038, 0.032], 0.008, [x, 1.003,  0.292], slotRail);
  chamfer([0.032, 0.038, 0.59], 0.008, [x - 0.251, 1.003, 0], slotRail);
  chamfer([0.032, 0.038, 0.59], 0.008, [x + 0.251, 1.003, 0], slotRail);
  // tiny metal registration pins communicate snap points without UI
  for (const sx of [-1, 1]) for (const sz of [-1, 1]) cyl(0.012, 0.012, 0.016, 10, [x + sx * 0.205, 1.026, sz * 0.247], iron);
}

// Iron corner brackets and nail heads make the bench feel assembled, not molded.
for (const x of [-1.17, 1.17]) for (const z of [-0.40, 0.40]) {
  chamfer([0.07, 0.035, 0.15], 0.006, [x, 0.917, z], metalDark);
  cyl(0.013, 0.013, 0.010, 10, [x, 0.939, z], iron);
}
for (const x of [-0.92, -0.46, 0, 0.46, 0.92]) {
  for (const z of [-0.37, 0.37]) cyl(0.012, 0.012, 0.010, 10, [x, 0.936, z], iron);
}

// Torch shaft: wood shaft, twine wraps, small shoulder collar.
const stick = new THREE.Group();
const shaft = cyl(0.047, 0.055, 0.50, 14, [0, 0, 0], woodDark, stick); shaft.rotation.z = Math.PI / 2;
for (const x of [-0.16, -0.11, -0.06, -0.01, 0.04, 0.09, 0.14]) {
  const wrap = new THREE.Mesh(geo(new THREE.TorusGeometry(0.055, 0.008, 6, 18)), clothDark);
  wrap.rotation.y = Math.PI / 2; wrap.position.x = x; stick.add(wrap);
}
const collar = new THREE.Mesh(geo(new THREE.TorusGeometry(0.058, 0.009, 6, 18)), iron);
collar.rotation.y = Math.PI / 2; collar.position.x = 0.19; stick.add(collar);
stick.position.set(-0.83, 1.045, 0); root.add(stick);

// Cloth roll: layered cylinder with visible core and two ties.
const clothRoll = new THREE.Mesh(geo(new THREE.CylinderGeometry(0.10, 0.105, 0.33, 18)), cloth);
clothRoll.rotation.z = Math.PI / 2; clothRoll.position.set(-0.28, 1.047, 0); root.add(clothRoll);
const core = new THREE.Mesh(geo(new THREE.TorusGeometry(0.048, 0.009, 6, 18)), clothDark);
core.rotation.y = Math.PI / 2; core.position.set(-0.445, 1.047, 0); root.add(core);
for (const dx of [-0.09, 0.09]) {
  const tie = new THREE.Mesh(geo(new THREE.TorusGeometry(0.103, 0.009, 6, 18)), clothDark);
  tie.rotation.y = Math.PI / 2; tie.position.set(-0.28 + dx, 1.047, 0); root.add(tie);
}

// Resin cup: foot, body, lip, resin surface.
cyl(0.125, 0.155, 0.085, 18, [0.28, 1.038, 0], resin);
cyl(0.112, 0.112, 0.018, 18, [0.28, 0.995, 0], resin);
const lip = new THREE.Mesh(geo(new THREE.TorusGeometry(0.13, 0.014, 7, 20)), resin);
lip.rotation.x = Math.PI / 2; lip.position.set(0.28, 1.082, 0); root.add(lip);
cyl(0.104, 0.104, 0.010, 18, [0.28, 1.089, 0], resinTop);

// Hammer: wooden handle with pommel, steel eye/collar and asymmetric head.
const hammer = new THREE.Group();
const handle = cyl(0.032, 0.043, 0.405, 14, [-0.02, 0, 0], woodDark, hammer); handle.rotation.z = Math.PI / 2;
const pommel = cyl(0.045, 0.055, 0.055, 14, [-0.23, 0, 0], woodEdge, hammer); pommel.rotation.z = Math.PI / 2;
const eye = new THREE.Mesh(geo(new THREE.TorusGeometry(0.042, 0.009, 6, 18)), metalDark); eye.rotation.y = Math.PI / 2; eye.position.x = 0.14; hammer.add(eye);
chamfer([0.19, 0.115, 0.125], 0.012, [0.215, 0, 0], metal, hammer);
const peen = new THREE.Mesh(geo(new THREE.CylinderGeometry(0.035, 0.060, 0.09, 12)), metalDark); peen.rotation.z = Math.PI / 2; peen.position.x = 0.355; hammer.add(peen);
hammer.position.set(0.79, 1.05, 0); root.add(hammer);

scene.defaultCamera = new THREE.PerspectiveCamera(36, 1, 0.1, 100);
scene.defaultCamera.position.set(2.55, 1.95, 2.95);
scene.defaultCamera.lookAt(0, 0.72, 0);

if (isPreview) {
  scene.background = new THREE.Color(0xc9d3bd);
  const hemi = new THREE.HemisphereLight(0xe8f1df, 0x68704f, 1.0);
  const key = new THREE.DirectionalLight(0xffefd4, 1.6); key.position.set(3.5, 5, 4);
  scene.add(hemi, key);
  const seg = 26, rings = 7; const pos: number[] = [], col: number[] = []; const gA = new THREE.Color(0x7fb038), gB = new THREE.Color(0x9dcb46), dA = new THREE.Color(0xb98d57), dB = new THREE.Color(0x9a6f42); const c = new THREE.Color();
  const pt = (r: number, a: number) => { const j = Math.sin(r * 7.1 + a * 13.3) * .5 + .5; return [Math.cos(a) * (r + (j - .5) * .18), Math.sin(a) * (r + (j - .5) * .18)]; };
  for (let ri = 0; ri < rings; ri++) { const r0 = ri * 4.5 / rings, r1 = (ri + 1) * 4.5 / rings; for (let s = 0; s < seg; s++) { const a0 = s / seg * Math.PI * 2, a1 = (s + 1) / seg * Math.PI * 2; const [x0, z0] = pt(r0, a0), [x1, z1] = pt(r0, a1), [x2, z2] = pt(r1, a0), [x3, z3] = pt(r1, a1);
    const tris = r0 === 0 ? [[0, 0, x3, z3, x2, z2]] : [[x0, z0, x3, z3, x2, z2], [x0, z0, x1, z1, x3, z3]];
    for (const t of tris) { const cx = (t[0] + t[2] + t[4]) / 3, cz = (t[1] + t[3] + t[5]) / 3; const d = Math.hypot(cx * .8, cz * 1.3); const dirt = Math.max(0, Math.min(1, (2.2 - d) / .9)); const n = Math.sin(cx * 2.3 + cz * 1.7) * .5 + .5; c.copy(gA).lerp(gB, n).lerp(dA.clone().lerp(dB, 1 - n), dirt).multiplyScalar(.93 + .14 * (Math.sin(cx * 5 + cz * 3) * .5 + .5));
      for (let k = 0; k < 3; k++) { pos.push(t[k * 2], -.01, t[k * 2 + 1]); col.push(c.r, c.g, c.b); } } } }
  const fg = geo(new THREE.BufferGeometry()); fg.setAttribute("position", new THREE.Float32BufferAttribute(pos, 3)); fg.setAttribute("color", new THREE.Float32BufferAttribute(col, 3)); fg.computeVertexNormals();
  scene.add(new THREE.Mesh(fg, mat(new THREE.MeshStandardMaterial({ vertexColors: true, roughness: 1, flatShading: true }))));
}

onDispose(() => { for (const g of gs) g.dispose(); for (const m of ms) m.dispose(); for (const t of tx) t.dispose(); });